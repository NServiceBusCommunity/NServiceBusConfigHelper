<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ProjectDefaults" Version="1.0.184" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="TUnit" Version="1.76.28" />
    <PackageVersion Include="Verify" Version="33.3.4" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="Verify.Bunit" Version="14.1.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.2" />
    <PackageVersion Include="DiffEngine" Version="20.8.2" />
  </ItemGroup>
</Project>