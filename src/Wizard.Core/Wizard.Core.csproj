<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(GeneratedTargetFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Versions\package-versions.json" LogicalName="package-versions.json" />
  </ItemGroup>

  <!-- Bakes the values generated solutions must match: the SDK from the repo's global.json
       and the target framework from src/Directory.Build.props. RepoContractTests asserts both. -->
  <Target Name="GenerateWizardDefaults" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <WizardSdkVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../global.json')), '(?&lt;="version"\s*:\s*")[^"]+'))</WizardSdkVersion>
    </PropertyGroup>
    <Error Condition="'$(WizardSdkVersion)' == ''" Text="Could not read the sdk version from global.json." />
    <ItemGroup>
      <WizardDefaultsLine Include="// Generated by GenerateWizardDefaults in Wizard.Core.csproj." />
      <WizardDefaultsLine Include="public static class WizardDefaults" />
      <WizardDefaultsLine Include="{" />
      <WizardDefaultsLine Include="    public const string WizardVersion = &quot;$(Version)&quot;%3B" />
      <WizardDefaultsLine Include="    public const string TargetFramework = &quot;$(GeneratedTargetFramework)&quot;%3B" />
      <WizardDefaultsLine Include="    public const string SdkVersion = &quot;$(WizardSdkVersion)&quot;%3B" />
      <WizardDefaultsLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)WizardDefaults.g.cs"
      Lines="@(WizardDefaultsLine)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WizardDefaults.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WizardDefaults.g.cs" />
    </ItemGroup>
  </Target>

</Project>
